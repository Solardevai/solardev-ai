generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String       @id // Clerk user id
  email                 String       @unique
  plan                  String       @default("free")
  stripeCustomerId      String?      @unique
  stripeSubscriptionId  String?      @unique
  subscriptionStatus    String       @default("inactive")
  subscriptionPeriodEnd DateTime?
  createdAt             DateTime     @default(now())
  projects              Project[]
  usageEvents           UsageEvent[]
}

model Project {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])
  analysisSnapshots AnalysisSnapshot[]
  name              String
  technology        String             @default("solar")
  country           String             @default("")
  status            String             @default("screening")
  boundary          Json // GeoJSON Polygon
  areaSqm           Float?
  perimeterM        Float?
  centroidLat       Float?
  centroidLon       Float?
  mapCenterLat      Float?
  mapCenterLon      Float?
  mapZoom           Float?
  visibleLayers     Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerId])
}

model AnalysisSnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisType       String   @default("preliminary-site-score")
  methodologyVersion String
  score              Float?
  coveragePercent    Int
  confidence         String
  band               String
  payload            Json
  createdAt          DateTime @default(now())

  @@index([projectId, createdAt])
}

model UsageEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  units          Int      @default(1)
  periodKey      String
  projectId      String?
  snapshotId     String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([userId, kind, periodKey])
}
