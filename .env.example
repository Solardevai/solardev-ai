# Postgres connection string (e.g. Vercel Postgres / Neon).
# Use the pooled connection here for the app. When running
# `prisma migrate`, pass the unpooled/direct connection string
# instead (e.g. DATABASE_URL_UNPOOLED from Neon) via an inline
# env override, since migrations are unreliable over a pgbouncer
# transaction pool.
DATABASE_URL=

# Clerk authentication
# Use development keys locally and production keys only in the production
# environment. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Canonical application origin used for Stripe Checkout and Billing Portal
# redirects. Use the deployed https origin without a trailing slash.
NEXT_PUBLIC_APP_URL=https://www.solardev.ai

# Clerk webhook notifications
CLERK_WEBHOOK_SIGNING_SECRET=

# Resend sign-in notification emails
RESEND_API_KEY=
SIGN_IN_NOTIFICATION_EMAIL=info@solardev.ai
SIGN_IN_NOTIFICATION_FROM=SolarDev AI <notifications@solardev.ai>

# Stripe workspace subscriptions. STRIPE_WORKSPACE_PRO_PRICE_ID must reference
# the recurring Pro price in the same Stripe mode as STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WORKSPACE_PRO_PRICE_ID=

# Keep false during the open-access launch. Set true later to enforce the
# monthly UTC allowances and expose upgrade controls in the workspace.
BILLING_ENFORCEMENT_ENABLED=false

# Monthly UTC allowances used only when BILLING_ENFORCEMENT_ENABLED=true.
# Defaults are Free 3/2 and Pro 50/50 for score runs/reports respectively.
FREE_SITE_SCORE_MONTHLY_LIMIT=3
FREE_REPORT_MONTHLY_LIMIT=2
PRO_SITE_SCORE_MONTHLY_LIMIT=50
PRO_REPORT_MONTHLY_LIMIT=50

# Terrain analysis uses the public Mapzen Terrain Tiles dataset hosted by the
# AWS Open Data program. No provider API key is required.
